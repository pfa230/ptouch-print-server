# syntax=docker/dockerfile:1
# ---- build stage: PAPPL + ptouch-app ----
FROM debian:bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config git ca-certificates \
      libusb-1.0-0-dev libpng-dev libjpeg-dev zlib1g-dev \
      libcups2-dev libcupsimage2-dev libssl-dev libavahi-client-dev \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v1.4.11 https://github.com/michaelrsweet/pappl /tmp/pappl \
 && cd /tmp/pappl && ./configure && make && make install && ldconfig \
 && rm -rf /tmp/pappl
WORKDIR /src
COPY . .
RUN cmake -S . -B build-app && cmake --build build-app --target ptouch-app \
 && install -Dm755 build-app/ptouch-app /out/usr/local/bin/ptouch-app

# ---- runtime stage: slim ----
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      libusb-1.0-0 libcups2 libcupsimage2 libavahi-client3 \
      libpng16-16 libjpeg62-turbo zlib1g libssl3 \
      avahi-daemon dbus ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# PAPPL shared libs (SONAME chain) + the app
COPY --from=build /usr/local/lib/libpappl.so* /usr/local/lib/
COPY --from=build /out/usr/local/bin/ptouch-app /usr/local/bin/ptouch-app
RUN ldconfig
# fail the build if any runtime .so is missing
RUN sh -c 'ldd /usr/local/bin/ptouch-app | grep -i "not found" && exit 1 || true'
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY THIRD_PARTY_NOTICES.md /THIRD_PARTY_NOTICES.md
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
