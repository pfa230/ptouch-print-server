# syntax=docker/dockerfile:1
# ---- build stage: PAPPL + ptouch-app ----
FROM debian:bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config git ca-certificates python3 \
      libusb-1.0-0-dev libbluetooth-dev libpng-dev libjpeg-dev zlib1g-dev \
      libcups2-dev libcupsimage2-dev libssl-dev libavahi-client-dev libgnutls28-dev libkrb5-dev \
 && rm -rf /var/lib/apt/lists/*
# Retain Debian security fixes while correcting only raster EOF reporting.
COPY patches/cups-2.4.2-deb12u9-raster.patch /tmp/cups-raster.patch
COPY scripts/build-cups.sh /tmp/build-cups.sh
RUN /tmp/build-cups.sh /tmp/cups-raster.patch
COPY patches/pappl-1.4.11-raster.patch /tmp/pappl-raster.patch
COPY patches/pappl-1.4.11-finishings.patch /tmp/pappl-finishings.patch
COPY patches/pappl-1.4.11-job-history.patch /tmp/pappl-job-history.patch
RUN git clone --depth 1 --branch v1.4.11 https://github.com/michaelrsweet/pappl /tmp/pappl \
 && cd /tmp/pappl && patch --batch --forward --fuzz=0 -p1 < /tmp/pappl-raster.patch \
 && patch --batch --forward --fuzz=0 -p1 < /tmp/pappl-finishings.patch \
 && patch --batch --forward --fuzz=0 -p1 < /tmp/pappl-job-history.patch \
 && ./configure && make && make install && ldconfig \
 && rm -rf /tmp/pappl
WORKDIR /src
COPY . .
RUN cmake -S . -B build-app -DPTOUCH_CORE_ONLY=OFF && cmake --build build-app \
 && ctest --test-dir build-app --output-on-failure \
 && install -Dm755 build-app/ptouch-app /out/usr/local/bin/ptouch-app

# ---- runtime stage: slim ----
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      libusb-1.0-0 libcups2 libcupsimage2 libavahi-client3 \
      libpng16-16 libjpeg62-turbo zlib1g libssl3 \
      avahi-daemon dbus ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Patched ABI-compatible CUPS and PAPPL libraries (including SONAME links).
COPY --from=build /usr/local/lib/libcups.so* /usr/local/lib/
COPY --from=build /usr/local/lib/libcupsimage.so* /usr/local/lib/
COPY --from=build /usr/local/share/ptouch/cups-source-version /usr/local/share/ptouch/cups-source-version
# Fail rather than replace a newer runtime security revision with cached libraries.
RUN test "$(dpkg-query -W -f='${source:Version}' libcups2)" = "$(cat /usr/local/share/ptouch/cups-source-version)"
# PAPPL shared libs + the app
COPY --from=build /usr/local/lib/libpappl.so* /usr/local/lib/
COPY --from=build /out/usr/local/bin/ptouch-app /usr/local/bin/ptouch-app
RUN ldconfig
# fail the build if any runtime .so is missing
RUN sh -c 'ldd /usr/local/bin/ptouch-app | grep -i "not found" && exit 1 || true'
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY THIRD_PARTY_NOTICES.md /THIRD_PARTY_NOTICES.md
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
