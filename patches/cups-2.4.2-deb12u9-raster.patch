 /*
+ * 'cups_raster_read_header()' - Distinguish clean EOF from a partial header.
+ *
+ * Probe one byte through the same decoder buffer before reading the remainder.
+ * cups_raster_read can return zero after consuming a partial buffered read, so
+ * its return value alone cannot establish that the next header was absent.
+ */
+
+static ssize_t
+cups_raster_read_header(cups_raster_t *r, unsigned char *buf, size_t bytes)
+{
+  ssize_t count = cups_raster_read(r, buf, 1);
+
+  if (count != 1)
+  {
+    if (count < 0)
+      _cupsRasterAddError("Unable to read raster stream.");
+    return (0);
+  }
+
+  if (cups_raster_read(r, buf + 1, bytes - 1) != (ssize_t)(bytes - 1))
+  {
+    _cupsRasterAddError("Truncated raster page header.\n");
+    return (0);
+  }
+
+  return ((ssize_t)bytes);
+}
+
