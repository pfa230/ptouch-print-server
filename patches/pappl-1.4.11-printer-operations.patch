-  if (!printer->device_in_use && !printer->processing_job && printer->device_uri)
+  if (!printer->device_in_use && !printer->processing_job && printer->device_uri &&
+      !(printer->waiters && waiter_ready_no_lock(printer, printer->waiters)))
   {
 //    papplLogPrinter(printer, PAPPL_LOGLEVEL_DEBUG, "Opening device for status/maintenance.");
 
@@ -921,6 +956,87 @@ papplPrinterOpenDevice(
 }
 
 
+//
+// 'papplPrinterOpenDeviceQueued()' - Open the device behind earlier accepted work.
+//
+// This function takes its place behind every job and cut accepted before the
+// call and ahead of later ones, waiting through device contention.  `NULL` is
+// returned if the printer is deleted or cannot be opened when its turn comes.
+//
+// The returned device must be closed using the @link papplPrinterCloseDevice@
+// function.
+//
+
+pappl_device_t *			// O - Device or `NULL` if not possible
+papplPrinterOpenDeviceQueued(
+    pappl_printer_t *printer)		// I - Printer
+{
+  pappl_device_t	*device = NULL;	// Open device
+  pappl_waiter_t	*waiter,	// This acquisition
+			*prev;		// Previous acquisition
+
+
+  if (!printer)
+    return (NULL);
+
+  if ((waiter = (pappl_waiter_t *)calloc(1, sizeof(pappl_waiter_t))) == NULL)
+    return (NULL);
+
+  _papplRWLockWrite(printer);
+
+  waiter->job_id = printer->next_job_id - 1;
+
+  if ((prev = printer->waiters) != NULL)
+  {
+    while (prev->next)
+      prev = prev->next;
+    prev->next = waiter;
+  }
+  else
+    printer->waiters = waiter;
+
+  while (!printer->is_deleted && papplSystemIsRunning(printer->system) &&
+         (printer->waiters != waiter || printer->device_in_use || printer->processing_job ||
+          !waiter_ready_no_lock(printer, waiter)))
+  {
+    _papplRWUnlock(printer);
+    usleep(1000);
+    _papplRWLockWrite(printer);
+  }
+
+  if (!printer->is_deleted && papplSystemIsRunning(printer->system))
+  {
+    if (printer->device)
+    {
+      // A finished job may have left the device open; this acquisition owns it now.
+      papplDeviceClose(printer->device);
+      printer->device = NULL;
+    }
+
+    printer->device        = device = papplDeviceOpen(printer->device_uri, "printer", papplLogDevice, printer->system);
+    printer->device_in_use = device != NULL;
+  }
+
+  for (prev = printer->waiters; prev; prev = prev->next)
+  {
+    if (prev->next == waiter)
+    {
+      prev->next = waiter->next;
+      break;
+    }
+  }
+
+  if (printer->waiters == waiter)
+    printer->waiters = waiter->next;
+
+  free(waiter);
+
+  _papplRWUnlock(printer);
+
+  return (device);
+}
+
