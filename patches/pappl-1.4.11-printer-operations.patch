+// Is a queued acquisition's job-id boundary passed?  Called with the printer
+// locked; no active job at or before the boundary may remain.
+static bool
+waiter_ready_no_lock(pappl_printer_t *printer,	// I - Printer
+                     pappl_waiter_t *waiter)	// I - Waiting acquisition
+{
+  pappl_job_t	*job;			// Current job
+
+
+  for (job = (pappl_job_t *)cupsArrayGetFirst(printer->active_jobs); job; job = (pappl_job_t *)cupsArrayGetNext(printer->active_jobs))
+  {
+    if (job->job_id <= waiter->job_id)
+      return (false);
+  }
+
+  return (true);
+}
+
+
+// '_papplPrinterCutBarrierNoLock()' - Does a pending cut gate this job start?
+//
+// Called with the printer locked.  A job accepted after the oldest waiting
+// acquisition must not start until that acquisition has run.
+//
+
+bool					// O - `true` to hold the job back
+_papplPrinterCutBarrierNoLock(
+    pappl_printer_t *printer,		// I - Printer
+    pappl_job_t     *job)		// I - Job
+{
+  return (printer->waiters && job->job_id > printer->waiters->job_id);
+}
+
+
+// '_papplPrinterWaitingAcquisitions()' - Count queued device acquisitions.
+//
+// Confirms that a request has entered a printer's queued acquisition before
+// later work is accepted, so ordering can be demonstrated without a delay.
+
+int					// O - Number of waiting acquisitions
+_papplPrinterWaitingAcquisitions(
+    pappl_printer_t *printer)		// I - Printer
+{
+  int		count = 0;		// Number of waiting acquisitions
+  pappl_waiter_t *waiter;		// Current waiting acquisition
+
+
+  if (!printer)
+    return (0);
+
+  _papplRWLockRead(printer);
+  for (waiter = printer->waiters; waiter; waiter = waiter->next)
+    count ++;
+  _papplRWUnlock(printer);
+
+  return (count);
+}
+
