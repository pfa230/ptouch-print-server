+++ b/pappl/finishings-private.h
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: Apache-2.0
+// Bounded bridge for drivers declaring standard trim presets plus templates.
+// No public API or printer command policy; the driver consumes raw job attrs.
+#ifndef PAPPL_FINISHINGS_PRIVATE_H
+#define PAPPL_FINISHINGS_PRIVATE_H
+
+static inline bool
+_papplTrimPresets(ipp_t *attrs)
+{
+  ipp_attribute_t *supported = ippFindAttribute(attrs, "finishings-supported", IPP_TAG_ENUM);
+  return (ippFindAttribute(attrs, "finishings-col-database", IPP_TAG_BEGIN_COLLECTION) &&
+          ippContainsInteger(supported, 60) && ippContainsInteger(supported, 63));
+}
+
+static inline bool
+_papplHasFinishingTemplate(ipp_t *attrs, const char *name)
+{
+  ipp_attribute_t *database = ippFindAttribute(attrs, "finishings-col-database", IPP_TAG_BEGIN_COLLECTION);
+  cups_len_t i;
+  if (!name) return (false);
+  for (i = 0; i < ippGetCount(database); i ++)
+  {
+    const char *value = ippGetString(ippFindAttribute(ippGetCollection(database, i), "finishing-template", IPP_TAG_KEYWORD), 0, NULL);
+    if (value && !strcmp(value, name)) return (true);
+  }
+  return (false);
+}
+
+// -1 invalid, 0 an advertised template with no enum equivalent, else enum.
+static inline int
+_papplTrimSelection(ipp_t *attrs, ipp_attribute_t *selection)
+{
+  ipp_attribute_t *supported = ippFindAttribute(attrs, "finishings-supported", IPP_TAG_ENUM);
+  int result = 3;
+  cups_len_t i;
+  if (!selection) return (-1);
+  if (ippGetValueTag(selection) == IPP_TAG_NOVALUE)
+    return (ippGetCount(selection) == 1 && ippContainsInteger(supported, 3) ? 3 : -1);
+  if (ippGetValueTag(selection) == IPP_TAG_ENUM && ippGetCount(selection) > 0)
+  {
+    for (i = 0; i < ippGetCount(selection); i ++)
+    {
+      int value = ippGetInteger(selection, i);
+      if (!ippContainsInteger(supported, value)) return (-1);
+      if (value == 3) continue;
+      if (value != 11 && value != 60 && value != 63) return (-1);
+      if (result == 3 || (result == 63 && (value == 11 || value == 60)) || value == 60)
+        result = value;
+    }
+    return (result);
+  }
+  if (ippGetValueTag(selection) == IPP_TAG_BEGIN_COLLECTION && ippGetCount(selection) == 1)
+  {
+    ipp_t *col = ippGetCollection(selection, 0);
+    ipp_attribute_t *member;
+    const char *name;
+    for (member = ippGetFirstAttribute(col); member; member = ippGetNextAttribute(col))
+      if (!ippGetName(member) || strcmp(ippGetName(member), "finishing-template") || ippGetValueTag(member) != IPP_TAG_KEYWORD || ippGetCount(member) != 1)
+        return (-1);
+    name = ippGetString(ippFindAttribute(col, "finishing-template", IPP_TAG_KEYWORD), 0, NULL);
+    if (!_papplHasFinishingTemplate(attrs, name)) return (-1);
+    result = ippEnumValue("finishings", name);
+    return (result == 11 || result == 60 || result == 63 ? result : 0);
+  }
+  return (-1);
+}
+
+// Existing vendor/state representation is a comma-separated enum list.
+static inline int
+_papplTrimDefaultString(ipp_t *attrs, const char *value)
+{
+  int values[32], count = 0, result;
+  char *end;
+  ipp_t *request;
+  if (!value || !*value) return (-1);
+  while (*value)
+  {
+    long number;
+    errno = 0;
+    number = strtol(value, &end, 10);
+    if (errno == ERANGE || end == value || (*end && *end != ',') ||
+        (number != 3 && number != 11 && number != 60 && number != 63) || count == 32)
+      return (-1);
+    values[count ++] = (int)number;
+    if (!*end) break;
+    value = end + 1;
+    if (!*value) return (-1);
+  }
+  request = ippNew();
+  result = _papplTrimSelection(attrs, ippAddIntegers(request, IPP_TAG_JOB, IPP_TAG_ENUM, "finishings", count, values));
+  ippDelete(request);
+  return (result);
+}
+
+static inline bool
+_papplSameTrimSelection(int a, int b)
+{
+  return ((a == 11 ? 60 : a) == (b == 11 ? 60 : b));
+}
+
+static inline int
+_papplTrimDefault(ipp_t *attrs, ipp_attribute_t *enums, ipp_attribute_t *collection)
+{
+  int a, b;
+  if (enums && ippGetValueTag(enums) != IPP_TAG_ENUM) return (-1);
+  if (collection && ippGetValueTag(collection) != IPP_TAG_BEGIN_COLLECTION && ippGetValueTag(collection) != IPP_TAG_NOVALUE) return (-1);
+  a = enums ? _papplTrimSelection(attrs, enums) : -1;
+  b = collection ? _papplTrimSelection(attrs, collection) : -1;
+  if ((enums && a <= 0) || (collection && b <= 0)) return (-1);
+  if (enums && collection && !_papplSameTrimSelection(a, b)) return (-1);
+  return (enums ? a : b);
+}
+
+// Caller holds the printer write lock. Both representations change together.
+static inline void
+_papplSetTrimDefault(ipp_t *attrs, int value)
+{
+  ipp_attribute_t *old;
+  while ((old = ippFindAttribute(attrs, "finishings-default", IPP_TAG_ZERO)) != NULL) ippDeleteAttribute(attrs, old);
+  while ((old = ippFindAttribute(attrs, "finishings-col-default", IPP_TAG_ZERO)) != NULL) ippDeleteAttribute(attrs, old);
+  ippAddInteger(attrs, IPP_TAG_PRINTER, IPP_TAG_ENUM, "finishings-default", value);
+  if (value == 3)
+    ippAddOutOfBand(attrs, IPP_TAG_PRINTER, IPP_TAG_NOVALUE, "finishings-col-default");
+  else
+  {
+    ipp_t *col = ippNew();
+    ippAddString(col, IPP_TAG_ZERO, IPP_TAG_KEYWORD, "finishing-template", NULL, ippEnumString("finishings", value));
+    ippAddCollection(attrs, IPP_TAG_PRINTER, "finishings-col-default", col);
+    ippDelete(col);
+  }
+}
+#endif
