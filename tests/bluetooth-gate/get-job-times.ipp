# Completed jobs with their timing: ipptool -tv URI get-job-times.ipp
{
  NAME "Get-Jobs completed with times"
  OPERATION Get-Jobs
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR naturalLanguage attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name bluetooth-gate
  ATTR keyword which-jobs completed
  ATTR keyword requested-attributes job-id,job-state,job-state-message,time-at-processing,time-at-completed
  STATUS successful-ok
}
